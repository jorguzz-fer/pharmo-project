# DATABASE_URL will be set by Easypanel PostgreSQL service
DATABASE_URL=

# JWT Secret - CHANGE THIS!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS - Add your frontend domain
ALLOWED_ORIGINS=https://your-domain.com

# WhatsApp Cloud API (Meta) — sem as duas, nada é enviado ao tutor
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: só mude se usar uma versão diferente da API
WHATSAPP_API_URL=https://graph.facebook.com/v17.0

# Mercado Pago — sem o access token nenhuma cobrança é gerada
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook (painel do Mercado Pago > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública deste servidor que o Mercado Pago vai notificar
MERCADOPAGO_WEBHOOK_URL=https://sua-api.com.br/api/pagamentos/webhook/mercadopago

# Supabase Storage (para upload de documentos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Resend (para envio de emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Frontend URL (para links de recuperação de senha)
FRONTEND_URL=http://localhost:5173

# OpenAI API Key (para assistente IA do Bulário)
OPENAI_API_KEY=sk-...
