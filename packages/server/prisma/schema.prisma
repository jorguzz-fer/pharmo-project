generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Especie {
  CANINO
  FELINO
  EQUINO
  BOVINO
  AVIAR
  SILVESTRE
  OUTRO
}

enum FormaFarmaceutica {
  CAPSULA
  COMPRIMIDO
  LIQUIDO
  BISCOITO
  PASTA
  POMADA
  OLEO
  INJETAVEL
  OUTRO
}

enum UnidadeDose {
  MG
  G
  ML
  MCG
  UI
}

enum PrescricaoStatus {
  DRAFT
  VALIDADA
  ASSINADA
  ENVIADA
  CANCELADA
}

enum ValidacaoTipo {
  DENTRO_FAIXA
  FORA_FAIXA_ACEITO
  FORA_FAIXA_REJEITADO
}

enum ClinicaUsuarioRole {
  ADMIN_CLINICA
  VETERINARIO
  RECEPCIONISTA
  FARMACEUTICO
}

enum ClinicaStatus {
  ATIVA
  SUSPENSA
  INATIVA
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPORTE
}

// ============================================================
// TENANT (CLINICA)
// ============================================================

model Clinica {
  id               String        @id @default(uuid())
  nome_fantasia    String
  razao_social     String
  cnpj             String        @unique
  inscricao_estadual String?

  // Contato
  email            String
  telefone         String?
  whatsapp         String?

  // Endereco
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  estado           String?

  // Branding (white label)
  logo_url         String?
  cor_primaria     String?       @default("#2563EB")
  cor_secundaria   String?       @default("#1E40AF")

  // Status e config
  status           ClinicaStatus @default(ATIVA)
  configuracoes    Json?         @default("{}")

  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  // Relations
  usuarios         ClinicaUsuario[]
  tutores          Tutor[]
  animais          Animal[]
  prescricoes      Prescricao[]
  protocolos       Protocolo[]
  validacao_logs   ValidacaoLog[]
  audit_logs       AuditLog[]

  @@map("clinicas")
}

// ============================================================
// USUARIOS DA CLINICA (multi-tenant)
// ============================================================

model ClinicaUsuario {
  id               String              @id @default(uuid())
  clinica_id       String
  nome             String
  email            String              @unique
  senha_hash       String
  role             ClinicaUsuarioRole  @default(VETERINARIO)

  // Vinculo profissional (se for veterinario)
  veterinario_id   String?

  // Refresh token
  refresh_token    String?
  refresh_token_exp DateTime?

  ativo            Boolean             @default(true)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  clinica          Clinica             @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  veterinario      Veterinario?        @relation(fields: [veterinario_id], references: [id])

  prescricoes      Prescricao[]

  @@index([clinica_id])
  @@index([email])
  @@map("clinica_usuarios")
}

// ============================================================
// VETERINARIO (perfil profissional)
// ============================================================

model Veterinario {
  id               String   @id @default(uuid())
  nome             String
  cpf              String?  @unique
  crmv             String
  uf_crmv          String
  email            String   @unique
  telefone         String?
  especialidades   String[]
  assinatura_url   String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  usuarios         ClinicaUsuario[]
  prescricoes      Prescricao[]
  validacao_logs   ValidacaoLog[]

  @@unique([crmv, uf_crmv])
  @@map("veterinarios")
}

// ============================================================
// TUTOR
// ============================================================

model Tutor {
  id               String   @id @default(uuid())
  clinica_id       String
  nome             String
  cpf              String?
  email            String?
  telefone         String?
  whatsapp         String?
  endereco         String?
  cidade           String?
  estado           String?
  cep              String?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  clinica          Clinica  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  animais          Animal[]
  prescricoes      Prescricao[]

  @@index([clinica_id])
  @@index([cpf])
  @@map("tutores")
}

// ============================================================
// ANIMAL (PACIENTE)
// ============================================================

model Animal {
  id               String    @id @default(uuid())
  clinica_id       String
  tutor_id         String
  nome             String
  especie          Especie
  raca             String?
  sexo             String?
  peso_kg          Decimal?  @db.Decimal(8, 3)
  data_nascimento  DateTime?
  observacoes      String?
  ativo            Boolean   @default(true)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  clinica          Clinica   @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  tutor            Tutor     @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  prescricoes      Prescricao[]

  @@index([clinica_id])
  @@index([tutor_id])
  @@map("animais")
}

// ============================================================
// PRINCIPIO ATIVO (tabela global)
// ============================================================

model PrincipioAtivo {
  id                  String   @id @default(uuid())
  nome_padronizado    String   @unique
  classe_terapeutica  String?
  controlado          Boolean  @default(false)
  descricao_palatavel String?
  observacoes         String?

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  concentracoes       PrincipioAtivoConcentracao[]
  faixas_terapeuticas FaixaTerapeutica[]
  protocolo_itens     ProtocoloItem[]
  prescricao_itens    PrescricaoItem[]

  @@map("principios_ativos")
}

// ============================================================
// CONCENTRACOES VALIDAS
// ============================================================

model PrincipioAtivoConcentracao {
  id                  String            @id @default(uuid())
  principio_ativo_id  String
  valor               Decimal           @db.Decimal(10, 4)
  unidade             UnidadeDose       @default(MG)
  forma_farmaceutica  FormaFarmaceutica @default(CAPSULA)
  ativo               Boolean           @default(true)

  created_at          DateTime          @default(now())

  principio_ativo     PrincipioAtivo    @relation(fields: [principio_ativo_id], references: [id], onDelete: Cascade)
  protocolo_itens     ProtocoloItem[]
  prescricao_itens    PrescricaoItem[]

  @@index([principio_ativo_id])
  @@map("principio_ativo_concentracoes")
}

// ============================================================
// FAIXA TERAPEUTICA (range por especie/peso)
// ============================================================

model FaixaTerapeutica {
  id                  String    @id @default(uuid())
  principio_ativo_id  String
  especie             Especie
  peso_min_kg         Decimal?  @db.Decimal(8, 3)
  peso_max_kg         Decimal?  @db.Decimal(8, 3)
  dose_min_mg_kg      Decimal   @db.Decimal(10, 4)
  dose_max_mg_kg      Decimal   @db.Decimal(10, 4)
  frequencia_horas    Int?
  observacoes         String?
  fonte_referencia    String?

  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  principio_ativo     PrincipioAtivo @relation(fields: [principio_ativo_id], references: [id], onDelete: Cascade)

  @@index([principio_ativo_id])
  @@index([principio_ativo_id, especie])
  @@map("faixas_terapeuticas")
}

// ============================================================
// PROTOCOLO (prescricao pronta - modo A)
// ============================================================

model Protocolo {
  id               String    @id @default(uuid())
  clinica_id       String?
  codigo           String
  nome             String
  descricao        String?
  especie_alvo     Especie?
  indicacao        String?
  ativo            Boolean   @default(true)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  clinica          Clinica?  @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  itens            ProtocoloItem[]
  prescricoes      Prescricao[]

  @@unique([clinica_id, codigo])
  @@index([clinica_id])
  @@map("protocolos")
}

model ProtocoloItem {
  id                  String   @id @default(uuid())
  protocolo_id        String
  principio_ativo_id  String
  concentracao_id     String?
  dose_mg_kg          Decimal  @db.Decimal(10, 4)
  frequencia_horas    Int
  duracao_dias        Int
  observacoes         String?
  ordem               Int      @default(0)

  protocolo           Protocolo                  @relation(fields: [protocolo_id], references: [id], onDelete: Cascade)
  principio_ativo     PrincipioAtivo             @relation(fields: [principio_ativo_id], references: [id])
  concentracao        PrincipioAtivoConcentracao? @relation(fields: [concentracao_id], references: [id])

  @@index([protocolo_id])
  @@map("protocolo_itens")
}

// ============================================================
// PRESCRICAO
// ============================================================

model Prescricao {
  id               String            @id @default(uuid())
  clinica_id       String
  usuario_id       String
  veterinario_id   String
  tutor_id         String
  animal_id        String
  protocolo_id     String?

  diagnostico      String?
  observacoes      String?
  status           PrescricaoStatus  @default(DRAFT)
  pdf_url          String?

  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  signed_at        DateTime?

  clinica          Clinica           @relation(fields: [clinica_id], references: [id])
  usuario          ClinicaUsuario    @relation(fields: [usuario_id], references: [id])
  veterinario      Veterinario       @relation(fields: [veterinario_id], references: [id])
  tutor            Tutor             @relation(fields: [tutor_id], references: [id])
  animal           Animal            @relation(fields: [animal_id], references: [id])
  protocolo        Protocolo?        @relation(fields: [protocolo_id], references: [id])

  itens            PrescricaoItem[]
  validacao_logs   ValidacaoLog[]

  @@index([clinica_id])
  @@index([veterinario_id])
  @@index([tutor_id])
  @@index([animal_id])
  @@index([status])
  @@map("prescricoes")
}

// ============================================================
// ITEM DA PRESCRICAO
// ============================================================

model PrescricaoItem {
  id                  String            @id @default(uuid())
  prescricao_id       String
  principio_ativo_id  String
  concentracao_id     String?

  dose_mg_kg          Decimal           @db.Decimal(10, 4)
  dose_total_mg       Decimal?          @db.Decimal(10, 2)
  frequencia_horas    Int
  duracao_dias        Int
  quantidade_total    Int?
  forma_farmaceutica  FormaFarmaceutica @default(CAPSULA)
  posologia_texto     String?
  observacoes         String?
  ordem               Int               @default(0)

  created_at          DateTime          @default(now())

  prescricao          Prescricao        @relation(fields: [prescricao_id], references: [id], onDelete: Cascade)
  principio_ativo     PrincipioAtivo    @relation(fields: [principio_ativo_id], references: [id])
  concentracao        PrincipioAtivoConcentracao? @relation(fields: [concentracao_id], references: [id])
  validacao_logs      ValidacaoLog[]

  @@index([prescricao_id])
  @@map("prescricao_itens")
}

// ============================================================
// LOG DE VALIDACAO (JURIDICO / AUDITAVEL)
// ============================================================

model ValidacaoLog {
  id                    String        @id @default(uuid())
  prescricao_id         String
  prescricao_item_id    String?
  clinica_id            String
  veterinario_id        String

  tipo                  ValidacaoTipo
  dose_prescrita_mg_kg  Decimal       @db.Decimal(10, 4)
  dose_min_mg_kg        Decimal?      @db.Decimal(10, 4)
  dose_max_mg_kg        Decimal?      @db.Decimal(10, 4)
  especie               Especie
  peso_animal_kg        Decimal       @db.Decimal(8, 3)
  principio_ativo_nome  String

  motivo_aceite         String?
  ip_address            String?
  user_agent            String?

  created_at            DateTime      @default(now())

  prescricao            Prescricao     @relation(fields: [prescricao_id], references: [id])
  prescricao_item       PrescricaoItem? @relation(fields: [prescricao_item_id], references: [id])
  clinica               Clinica        @relation(fields: [clinica_id], references: [id])
  veterinario           Veterinario    @relation(fields: [veterinario_id], references: [id])

  @@index([prescricao_id])
  @@index([clinica_id])
  @@index([veterinario_id])
  @@index([created_at])
  @@map("validacao_logs")
}

// ============================================================
// AUDIT LOG (GERAL)
// ============================================================

model AuditLog {
  id               String   @id @default(uuid())
  clinica_id       String?
  usuario_id       String?
  usuario_tipo     String?
  entidade         String
  entidade_id      String
  acao             String
  dados_anteriores Json?
  dados_novos      Json?
  ip_address       String?

  created_at       DateTime @default(now())

  clinica          Clinica? @relation(fields: [clinica_id], references: [id])

  @@index([clinica_id])
  @@index([entidade, entidade_id])
  @@index([created_at])
  @@map("audit_logs")
}

// ============================================================
// ADMIN DA PLATAFORMA (super-admin)
// ============================================================

model AdminUsuario {
  id               String    @id @default(uuid())
  nome             String
  email            String    @unique
  senha_hash       String
  role             AdminRole @default(ADMIN)
  refresh_token    String?
  refresh_token_exp DateTime?
  ativo            Boolean   @default(true)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("admin_usuarios")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  user_type  String
  expires_at DateTime
  used       Boolean  @default(false)
  used_at    DateTime?
  created_at DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}
