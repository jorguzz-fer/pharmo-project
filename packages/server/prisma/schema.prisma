generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  OPERATOR
  FINANCIAL
}

enum VetStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ClinicaStatus {
  PENDENTE
  EM_ANALISE
  APROVADA
  SUSPENSA
  INATIVA
}

enum PrescricaoStatus {
  DRAFT
  SIGNED
  SENT
}

enum PagamentoStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PedidoStatus {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_CONFIRMADO
  EM_PRODUCAO
  PRONTO_ENTREGA
  ENTREGUE
  CANCELADO
}

enum MetodoPagamento {
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

// 1. Veterinarios
model Veterinario {
  id             String    @id @default(uuid())
  nome           String
  cpf            String?   @unique
  crv            String    @unique
  uf_crmv        String? // Ex: "SP", "RJ"
  numero_crmv    String? // Ex: "12345"
  email          String    @unique
  telefone       String
  senha_hash     String
  especialidade  String?
  especialidades String[] // Array de especialidades
  status         VetStatus @default(PENDING)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  prescricoes Prescricao[]
  clinicas    ClinicaVeterinario[]
  logsCiencia LogCiencia[]

  @@map("veterinarios")
}

// 2. Tutores
model Tutor {
  id         String   @id @default(uuid())
  nome       String
  cpf        String   @unique
  email      String?
  telefone   String?
  endereco   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  animais     Animal[]
  prescricoes Prescricao[]

  @@map("tutores")
}

// 3. Animais
model Animal {
  id              String    @id @default(uuid())
  tutor_id        String
  nome            String
  especie         String
  raca            String?
  peso            Float?
  data_nascimento DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tutor       Tutor        @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  prescricoes Prescricao[]
  logsCiencia LogCiencia[]

  @@map("animais")
}

// 4. Bulario
model Bulario {
  id               String   @id @default(uuid())
  doenca           String
  principio_ativo  String
  concentracao     String?
  posologia        String
  contraindicacoes String?
  controlado       Boolean  @default(false)
  species          String?  // "dog" | "cat" | null
  route_hint       String?  // "ORAL" | "VO" | "TOPICO" | null
  source_record_id Int?     // record_id do CSV de origem
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([principio_ativo, species])
  @@map("bulario")
}

// 5. Prescricoes
model Prescricao {
  id                 String           @id @default(uuid())
  veterinario_id     String
  tutor_id           String
  animal_id          String
  clinica_id         String? // NOVO: vincula prescrição à clínica
  doenca             String?
  medicamento        String // DEPRECATED: mantido para compatibilidade
  dosagem            String // DEPRECATED: mantido para compatibilidade
  forma_farmaceutica String // DEPRECATED: mantido para compatibilidade
  quantidade         String // DEPRECATED: mantido para compatibilidade
  observacoes        String?
  status             PrescricaoStatus @default(DRAFT)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  veterinario  Veterinario             @relation(fields: [veterinario_id], references: [id])
  tutor        Tutor                   @relation(fields: [tutor_id], references: [id])
  animal       Animal                  @relation(fields: [animal_id], references: [id])
  clinica      Clinica?                @relation(fields: [clinica_id], references: [id])
  orcamento    Orcamento?
  medicamentos PrescricaoMedicamento[]
  logsCiencia  LogCiencia[]

  @@map("prescricoes")
}

// 5.1. Prescricao Medicamentos (Novo - Suporta múltiplos medicamentos)
model PrescricaoMedicamento {
  id                 String   @id @default(uuid())
  prescricao_id      String
  codigo_medicamento String? // Código do bulário
  medicamento        String // Nome do medicamento
  dosagem            String // Ex: "10mg/kg"
  forma_farmaceutica String // Ex: "Comprimido", "Líquido"
  quantidade         String // Ex: "1 caixa", "30 comprimidos"
  observacoes        String? // Posologia detalhada
  created_at         DateTime @default(now())

  prescricao Prescricao @relation(fields: [prescricao_id], references: [id], onDelete: Cascade)

  @@map("prescricao_medicamentos")
}

// 6. Orcamentos
model Orcamento {
  id               String           @id @default(uuid())
  prescricao_id    String           @unique
  valor_total      Decimal          @db.Decimal(10, 2)
  status_pagamento PagamentoStatus  @default(PENDING)
  link_pagamento   String?
  data_pagamento   DateTime?
  metodo_pagamento MetodoPagamento?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  prescricao Prescricao @relation(fields: [prescricao_id], references: [id])
  pedido     Pedido?

  @@map("orcamentos")
}

// 7. Conversas IA
model ConversaIA {
  id         String   @id @default(uuid())
  telefone   String
  mensagem   String
  resposta   String
  tipo       String? // Ex: "duvida_tecnica", "orcamento"
  created_at DateTime @default(now())

  @@map("conversas_ia")
}

// 8. Pedidos
model Pedido {
  id              String       @id @default(uuid())
  orcamento_id    String       @unique
  status_producao PedidoStatus @default(AGUARDANDO_PAGAMENTO)
  data_producao   DateTime?
  data_entrega    DateTime?
  observacoes     String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  orcamento Orcamento  @relation(fields: [orcamento_id], references: [id])
  followups FollowUp[]

  @@map("pedidos")
}

// 9. Usuarios Admin
model UsuarioAdmin {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senha_hash String
  role       UserRole @default(OPERATOR)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios_admin")
}

// 10. Follow-ups
model FollowUp {
  id           String   @id @default(uuid())
  pedido_id    String
  mensagem     String
  realizado    Boolean  @default(false)
  data_contato DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  pedido Pedido @relation(fields: [pedido_id], references: [id])

  @@map("follow_ups")
}

// 11. Clínicas
model Clinica {
  id                 String  @id @default(uuid())
  nome_fantasia      String
  razao_social       String
  cnpj               String  @unique
  inscricao_estadual String?
  email              String
  telefone           String?
  whatsapp           String?

  // Endereço
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  // Branding
  logo_url String?

  // Condições comerciais (precificação por parceiro)
  taxa_manipulacao    Decimal? @db.Decimal(10, 2) // R$ fixo por pedido
  custo_embalagens    Decimal? @db.Decimal(10, 2) // R$ fixo por pedido
  desconto_parceiro   Decimal? @db.Decimal(5, 4)  // % desconto (0.40 = 40%)
  adicional_entrega   Decimal? @db.Decimal(10, 2) // R$ fixo por pedido
  adicional_biscoito  Decimal? @db.Decimal(10, 2) // R$ extra se forma = biscoito

  // Responsável
  responsavel_legal String
  cpf_responsavel   String

  // Autenticação
  senha_hash          String?
  reset_token         String?
  reset_token_expires DateTime?

  // Status e controle
  status               ClinicaStatus @default(PENDENTE)
  observacoes_internas String?

  // Auditoria
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  approved_at DateTime?
  approved_by String?

  // Relações
  documentos   ClinicaDocumento[]
  veterinarios ClinicaVeterinario[]
  prescricoes  Prescricao[]

  @@map("clinicas")
}

// 12. Documentos de Clínicas
model ClinicaDocumento {
  id             String   @id @default(uuid())
  clinica_id     String
  tipo_documento String // 'contrato_social', 'cartao_cnpj', 'comprovante_endereco', 'contrato_assinado'
  nome_arquivo   String
  url_arquivo    String
  mime_type      String?
  tamanho_bytes  Int?
  uploaded_by    String?
  created_at     DateTime @default(now())

  clinica Clinica @relation(fields: [clinica_id], references: [id], onDelete: Cascade)

  @@map("clinica_documentos")
}

// 13. Relação Clínica-Veterinário (Many-to-Many)
model ClinicaVeterinario {
  id             String   @id @default(uuid())
  clinica_id     String
  veterinario_id String
  cargo          String?  @default("Veterinário")
  status         String   @default("ativo") // 'ativo', 'inativo'
  created_at     DateTime @default(now())

  clinica     Clinica     @relation(fields: [clinica_id], references: [id], onDelete: Cascade)
  veterinario Veterinario @relation(fields: [veterinario_id], references: [id], onDelete: Cascade)

  @@unique([clinica_id, veterinario_id])
  @@map("clinica_veterinario")
}

// 14. Logs de Email
model EmailLog {
  id            String   @id @default(uuid())
  destinatario  String
  assunto       String?
  template      String?
  status        String // 'sent', 'failed', 'bounced'
  error_message String?
  metadata      Json?
  created_at    DateTime @default(now())

  @@map("email_logs")
}

// 15. Tokens de Recuperação de Senha
model PasswordResetToken {
  id         String    @id @default(uuid())
  email      String
  token      String    @unique
  user_type  String // 'veterinario' ou 'admin'
  expires_at DateTime
  used       Boolean   @default(false)
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")
}

// ========================================
// MOTOR CLÍNICO - VALIDAÇÃO TERAPÊUTICA
// ========================================

// 16. Princípios Ativos
model PrincipioAtivo {
  id                 String   @id @default(uuid())
  nome               String   @unique
  nome_cientifico    String?
  classe_terapeutica String?
  controlado         Boolean  @default(false)
  texto_palatavel    String?  @db.Text // Explicação simplificada
  observacoes        String?  @db.Text
  ativo              Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  concentracoes  Concentracao[]
  ranges         RangeTerapeutico[]
  protocoloItens ProtocoloItem[]
  logsCiencia    LogCiencia[]

  @@map("principios_ativos")
}

// 17. Concentrações Válidas
model Concentracao {
  id                 String   @id @default(uuid())
  principio_ativo_id String
  valor              Decimal  @db.Decimal(10, 4)
  unidade            String // 'mg', 'g', 'ml', 'UI'
  forma_farmaceutica String? // 'comprimido', 'cápsula', 'líquido', 'pasta'
  created_at         DateTime @default(now())

  principioAtivo PrincipioAtivo @relation(fields: [principio_ativo_id], references: [id], onDelete: Cascade)

  @@unique([principio_ativo_id, valor, unidade, forma_farmaceutica])
  @@map("concentracoes")
}

// 18. Ranges Terapêuticos
model RangeTerapeutico {
  id                 String   @id @default(uuid())
  principio_ativo_id String
  especie            String // 'canino', 'felino', 'equino', etc
  peso_min_kg        Decimal? @db.Decimal(6, 2) // NULL = sem limite mínimo
  peso_max_kg        Decimal? @db.Decimal(6, 2) // NULL = sem limite máximo
  dose_min_mg_kg     Decimal  @db.Decimal(10, 4)
  dose_max_mg_kg     Decimal  @db.Decimal(10, 4)
  frequencia_horas   Int? // Ex: 8, 12, 24
  duracao_max_dias   Int?
  observacoes        String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  principioAtivo PrincipioAtivo @relation(fields: [principio_ativo_id], references: [id], onDelete: Cascade)

  @@index([principio_ativo_id, especie])
  @@map("ranges_terapeuticos")
}

// 19. Protocolos (Prescrições Prontas)
model Protocolo {
  id         String   @id @default(uuid())
  codigo     String   @unique
  nome       String
  descricao  String?  @db.Text
  indicacao  String?  @db.Text // Para qual doença/condição
  especie    String? // 'canino', 'felino', etc
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  itens ProtocoloItem[]

  @@map("protocolos")
}

// 20. Itens do Protocolo
model ProtocoloItem {
  id                 String  @id @default(uuid())
  protocolo_id       String
  principio_ativo_id String
  dosagem_mg_kg      Decimal @db.Decimal(10, 4)
  frequencia_horas   Int
  duracao_dias       Int
  forma_farmaceutica String?
  observacoes        String? @db.Text
  ordem              Int     @default(0)

  protocolo      Protocolo      @relation(fields: [protocolo_id], references: [id], onDelete: Cascade)
  principioAtivo PrincipioAtivo @relation(fields: [principio_ativo_id], references: [id])

  @@map("protocolo_itens")
}

// 21. Log de Ciência (Auditoria Jurídica)
model LogCiencia {
  id                 String @id @default(uuid())
  prescricao_id      String
  veterinario_id     String
  principio_ativo_id String
  animal_id          String

  // Dados da prescrição
  dosagem_prescrita_mg_kg Decimal @db.Decimal(10, 4)
  peso_animal_kg          Decimal @db.Decimal(6, 2)
  dose_total_mg           Decimal @db.Decimal(10, 2)

  // Range esperado
  dose_min_esperada_mg_kg Decimal @db.Decimal(10, 4)
  dose_max_esperada_mg_kg Decimal @db.Decimal(10, 4)

  // Justificativa
  motivo             String  @db.Text
  aceite_veterinario Boolean @default(true)

  // Auditoria
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.Text
  created_at DateTime @default(now())

  prescricao     Prescricao     @relation(fields: [prescricao_id], references: [id], onDelete: Cascade)
  veterinario    Veterinario    @relation(fields: [veterinario_id], references: [id])
  principioAtivo PrincipioAtivo @relation(fields: [principio_ativo_id], references: [id])
  animal         Animal         @relation(fields: [animal_id], references: [id])

  @@index([prescricao_id])
  @@index([veterinario_id])
  @@index([created_at])
  @@map("logs_ciencia")
}

// ========================================
// BULÁRIO MAGISTRAL (RAG)
// ========================================

// 22. Bulário Magistral - Medicamentos manipulados PharmoPet
model BularioMagistral {
  id                 String   @id @default(uuid())
  codigo             String   @unique // "7.1", "4.3.2"
  nome               String // "Gel Otológico Antimicrobiano"
  linha_terapeutica  String // "Otológica", "Dermatológica"
  forma_farmaceutica String // "Gel otológico bioadesivo"
  indicacao          String   @db.Text // "Tratamento de otite bacteriana..."
  diferencial        String?  @db.Text
  formula            String   @db.Text // Ingredientes da fórmula
  modo_uso           String   @db.Text // "Aplicar 2 gotas..."
  especie            String[] // ["cães", "gatos"]
  observacoes        String?  @db.Text
  controlado         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("bulario_magistral")
}

// ========================================
// CATÁLOGO DE PRODUTOS PHARMOPET
// ========================================

// 23. Produtos (Catálogo de medicamentos com preço)
model Produto {
  id             String   @id @default(uuid())
  codigo         String   @unique
  nome           String
  preco_sugestao Decimal  @db.Decimal(10, 2) // Preço sugerido ao cliente
  preco_tabela   Decimal  @db.Decimal(10, 2) // Preço para clínica
  ativo          Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("produtos")
}

// ========================================
// INSUMOS FARMACÊUTICOS (BASE V3)
// ========================================

// 24. Insumo Farmacêutico — Princípios ativos com precificação
model InsumoFarmaceutico {
  id               String   @id @default(uuid())
  codigo_interno   Int      @unique // Código do sistema PharmoPet (ex: 665)
  descricao        String // Nome do princípio ativo (ex: "Gabapentina")
  valor_custo      Decimal  @db.Decimal(10, 5) // Custo por grama
  custo_referencia Decimal  @db.Decimal(10, 5) // Custo referência por grama
  markup           Decimal  @db.Decimal(10, 2) // Multiplicador (ex: 648 = 6.48x)
  un_manipulacao   String // Unidade de manipulação: "mg", "ml", "g"
  estoque          Decimal  @db.Decimal(10, 4) // Estoque disponível (grama/ml)
  calculo_tipo     String // "Cápsula", "Percentual", "Sem cálculo"
  controlado       Boolean  @default(false)
  lista_controle   String?  // "C1", "A2", etc. (se controlado)
  ativo            Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  regras_excecao RegraExcecao[]

  @@map("insumos_farmaceuticos")
}

// 25. Formas Farmacêuticas — Tipos de formulação disponíveis
model FormaFarmaceutica {
  id         String   @id @default(uuid())
  nome       String   @unique // "CÁPSULAS", "BISCOITOS", etc.
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  regras_excecao RegraExcecao[]

  @@map("formas_farmaceuticas")
}

// 26. Regras de Exceção — Incompatibilidades insumo × forma farmacêutica
model RegraExcecao {
  id                     String   @id @default(uuid())
  insumo_farmaceutico_id String
  forma_farmaceutica_id  String
  descricao              String // "NÃO FAZ EM PASTA"
  created_at             DateTime @default(now())

  insumo InsumoFarmaceutico @relation(fields: [insumo_farmaceutico_id], references: [id], onDelete: Cascade)
  forma  FormaFarmaceutica  @relation(fields: [forma_farmaceutica_id], references: [id], onDelete: Cascade)

  @@unique([insumo_farmaceutico_id, forma_farmaceutica_id])
  @@map("regras_excecao")
}
